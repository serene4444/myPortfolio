c:["$","section",null,{"id":"about","className":"border-b border-white/10 bg-transparent py-24 sm:py-28","children":["$","div",null,{"className":"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8","children":[["$","$L7",null,{"children":["$","div",null,{"className":"max-w-3xl","children":[["$","p",null,{"className":"font-mono text-sm uppercase tracking-[0.35em] text-cyan-200/80","children":"About Me"}],["$","h2",null,{"className":"mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl","children":"Software engineering with a curious mind and an adventurous spirit"}]]}]}],["$","div",null,{"className":"mt-14 grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-start","children":[["$","$L7",null,{"className":"relative","children":[["$","div",null,{"className":"overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 p-3 shadow-soft","children":["$","$L15",null,{"src":"/assets/selfie.jpg","alt":"Serene Plummer - About","width":960,"height":1200,"className":"h-[34rem] w-full rounded-[1.5rem] object-cover object-center"}]}],["$","div",null,{"className":"absolute -bottom-5 left-6 rounded-2xl border border-cyan-300/20 bg-slate-950/90 px-5 py-4 shadow-soft backdrop-blur-xl","children":[["$","p",null,{"className":"font-mono text-xs uppercase tracking-[0.3em] text-cyan-200/80","children":"Seattle-rooted"}],["$","p",null,{"className":"mt-1 max-w-xs text-sm text-slate-300","children":"Nature, movement, and new landscapes keep my energy high outside of engineering."}]]}]]}],["$","$L7",null,{"delay":100,"children":["$","div",null,{"className":"rounded-[2rem] border border-white/10 bg-white/5 p-8 shadow-soft backdrop-blur-xl sm:p-10","children":[["$","h3",null,{"className":"text-2xl font-semibold text-white","children":"Transforming Data into Insights"}],["$","div",null,{"className":"mt-6 space-y-5 text-base leading-8 text-slate-300","children":[["$","p","I’m Serene, an early-career software engineer with a background in Python, SQL, and machine learning. I love taking on complex problems, exploring data, and building predictive models that lead to smarter decisions. Along the way, I’ve gained hands-on experience in data visualization, ETL pipelines, and full-stack development, which gives me a well-rounded approach to solving data challenges.",{"children":"I’m Serene, an early-career software engineer with a background in Python, SQL, and machine learning. I love taking on complex problems, exploring data, and building predictive models that lead to smarter decisions. Along the way, I’ve gained hands-on experience in data visualization, ETL pipelines, and full-stack development, which gives me a well-rounded approach to solving data challenges."}],["$","p","Originally from Seattle, the outdoors has always felt like home to me. Whether I’m hiking mountain trails, snowboarding fresh powder, or traveling to breathtaking places like Colorado or upstate New York, I find my energy in nature and the adventure of new landscapes.",{"children":"Originally from Seattle, the outdoors has always felt like home to me. Whether I’m hiking mountain trails, snowboarding fresh powder, or traveling to breathtaking places like Colorado or upstate New York, I find my energy in nature and the adventure of new landscapes."}],["$","p","I’m always learning through certifications, projects, and real-world applications, and I’m driven by the idea of using data science to make a real impact while continuing to grow both professionally and personally.",{"children":"I’m always learning through certifications, projects, and real-world applications, and I’m driven by the idea of using data science to make a real impact while continuing to grow both professionally and personally."}]]}],"$L16"]}]}]]}]]}]}]
